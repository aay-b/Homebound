/// Represents every account that can participate in messaging.
model User {
  /// Stable Auth identity; the SQL migration manages the foreign key to auth.users.
  authUserId               String?              @unique(map: "users_auth_user_id_key") @map("auth_user_id") @db.Uuid
  id                       BigInt               @id @default(autoincrement())
  name                     String
  email                    String               @unique
  role                     String
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  sentMessageRequests      MessageRequest[]     @relation("MessageRequestSender")
  receivedMessageRequests  MessageRequest[]     @relation("MessageRequestRecipient")
  conversationMemberships  ConversationMember[]
  sentMessages             Message[]
  reactions                MessageReaction[]
  blocksInitiated          UserBlock[]          @relation("UserBlockBlocker")
  blocksReceived           UserBlock[]          @relation("UserBlockBlocked")
  submittedIssueReports    PlatformIssueReport[]

  @@map("Users")
}
